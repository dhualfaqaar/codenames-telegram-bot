# TELEGRAM_BOT_TOKEN: The bot token from @BotFather in Telegram.
# E.g. 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional APIs for cinema screenshot recognition and subtitle search.
GEMINI_API_KEY=
OPEN_SUBTITLES_API_KEY=
OPEN_SUBTITLES_USER_AGENT="CodenamesTelegramBot v1.0"
